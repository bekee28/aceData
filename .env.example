# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Generate a fresh secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Core Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=localhost:8000

# --- Stripe (use test keys for development) ---
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` or the webhook endpoint settings in the dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Pricing is set inline (no Stripe Products needed). Amounts are in cents.
STRIPE_CURRENCY=usd
TIER_2_NAME=Build
TIER_2_AMOUNT_CENTS=14900
TIER_3_NAME=Build Pro
TIER_3_AMOUNT_CENTS=34900

# --- Email ---
# Local dev prints emails to the console. For real sending, switch the backend
# and supply SMTP credentials (e.g. a Gmail App Password).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=you@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
